# FM Invoice Readiness Mailer — environment variables
# Copy to .env and fill in your values (never commit .env to git)

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///wm.db
APP_USERNAME=admin
APP_PASSWORD=changeme

# SMTP (Gmail with App Password recommended)
SMTP_USERNAME=sanemunijyothika2404@gmail.com
SMTP_APP_PASSWORD=smtp_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Alternatively, use n8n webhook
N8N_WEBHOOK_URL=

# ── Brevo (HTTPS email API — recommended for Render deployment) ──────────────
# Sign up free at https://app.brevo.com → Settings → API Keys → Create API key
# Free plan: 300 emails/day, no SMTP ports needed (works on Render free tier).
# Set SEND_MODE=brevo to use Brevo instead of SMTP.
BREVO_API_KEY=your_brevo_api_key_here
# Must match a verified sender in your Brevo account (Settings → Senders & IP)
BREVO_SENDER_EMAIL=sanemunijyothika2404@gmail.com

# Send mode: smtp | brevo | n8n
# Use 'brevo' on Render (SMTP ports 587/465 are blocked on Render free tier)
SEND_MODE=brevo

# Limits
MAX_UPLOAD_MB=50
MAX_EMAIL_RETRIES=3
EMAIL_TIMEOUT=30

# Branding
COMPANY_NAME=FORBES MARSHALL HYD PVT LTD

# Logging
LOG_LEVEL=INFO
FLASK_ENV=development
FLASK_DEBUG=1
